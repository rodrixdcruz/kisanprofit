[TEMPLATE]
# Copy to backend/.env and adjust. Everything defaults safely without it.

SECRET_KEY=change-me-to-random-64-hex
ACCESS_TOKEN_EXPIRE_MINUTES=10080        # 7 days

# sqlite:///./kisanprofit.db            (default, zero setup)
# DATABASE_URL=postgresql+psycopg://kisan:kisanprofit@db:5432/kisanprofit

CORS_ORIGINS=http://localhost:5173,http://localhost:5500

# AI provider: offline | gemini | openai | auto
AI_PROVIDER=offline
# GEMINI_API_KEY=...
# OPENAI_API_KEY=...

# Market prices (data.gov.in Agmarknet) — optional, live when set
# DATA_GOV_IN_API_KEY=...

# Recommended politeness header for Nominatim
# NOMINATIM_EMAIL=you@example.com

# Seed the read-only demo farm at startup.
SEED_DEMO_DATA=true

# Shared secret for POST /api/admin/reseed-demo, the nightly demo reset.
# Unset (the default) disables the route entirely — it then 404s, so an
# unconfigured deployment can never be reset by a stranger. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# RESEED_TOKEN=...

# --- demo account (public by design, read-only) ---
# Defaults match the login documented in the README. If you rotate the
# password, update the README and let a reset apply it (the nightly
# "Verify + reset demo farm" workflow, or run it with force_reset ticked) —
# the reset re-hashes from these settings rather than a value baked into code.
# DEMO_MOBILE=9999999999
# DEMO_PASSWORD=demo1234
# DEMO_NAME=Demo Farmer
# One-tap demo entry (POST /api/auth/demo-login). false makes the demo farm
# unreachable and the "Explore Demo Farm" button stop working.
DEMO_LOGIN_ENABLED=true

# --- rate limiting (per instance, in-process) ---
# Blunts password guessing, scripted sign-ups and AI-quota burn on a public
# origin. Tuned around a venue sharing one NAT IP; lower them if you prefer.
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_SECONDS=300
# RATE_LIMIT_LOGIN=20
# RATE_LIMIT_REGISTER=10
# RATE_LIMIT_DEMO_LOGIN=60
# RATE_LIMIT_CHAT_PER_USER=30
# RATE_LIMIT_CHAT_PER_IP=60
# Leave true only behind a proxy that sets X-Forwarded-For itself, otherwise a
# client could spoof the header and get a fresh budget per request.
TRUST_PROXY_HEADERS=true
# Which X-Forwarded-For entry is the caller: "first" on Render (its edge puts
# the real client IP first and an internal hop last), "last" behind the bundled
# nginx (it appends the peer it saw). Getting this wrong on Render collapses
# every visitor onto the platform's load balancer, i.e. one shared bucket.
PROXY_IP_POSITION=first
