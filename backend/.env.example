[TEMPLATE]
# Copy to backend/.env and adjust. Everything defaults safely without it.

SECRET_KEY=change-me-to-random-64-hex
ACCESS_TOKEN_EXPIRE_MINUTES=10080        # 7 days

# sqlite:///./kisanprofit.db            (default, zero setup)
# DATABASE_URL=postgresql+psycopg://kisan:kisanprofit@db:5432/kisanprofit

CORS_ORIGINS=http://localhost:5173,http://localhost:5500

# AI provider: offline | gemini | openai | auto
AI_PROVIDER=offline
# GEMINI_API_KEY=...
# OPENAI_API_KEY=...

# Market prices (data.gov.in Agmarknet) — optional, live when set
# DATA_GOV_IN_API_KEY=...

# Recommended politeness header for Nominatim
# NOMINATIM_EMAIL=you@example.com

# Seed the read-only demo farm (mobile 9999999999) at startup.
SEED_DEMO_DATA=true

# Shared secret for POST /api/admin/reseed-demo, the nightly demo reset.
# Unset (the default) disables the route entirely — it then 404s, so an
# unconfigured deployment can never be reset by a stranger. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# RESEED_TOKEN=...
